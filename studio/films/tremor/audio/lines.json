[
 {
  "id": "a1",
  "text": "Five pounds of air pressure.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "a2",
  "text": "One skyscraper.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "a3",
  "text": "Down.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "b1",
  "text": "Nineteen thirty-five. Tesla is seventy-nine.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "b2",
  "text": "He tells reporters about a small oscillator.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "b3",
  "text": "Clamped to a steel girder, he says,",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "b4",
  "text": "five pounds of air pressure could bring down",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "b5",
  "text": "the Empire State Building.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "c1",
  "text": "He tells another story.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "c2",
  "text": "His lab on Houston Street starts to shake.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "c3",
  "text": "The neighbors complain. The police arrive.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "c4",
  "text": "He stops it with a sledgehammer.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "d1",
  "text": "In two thousand six, a TV test rebuilt the idea.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "d2",
  "text": "The verdict: busted.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "e1",
  "text": "But the force behind it is real.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "e2",
  "text": "Eighteen thirty-one. Soldiers march in step across a bridge.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "e3",
  "text": "It starts to bounce. A bolt snaps.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "e4",
  "text": "Nineteen forty. Wind feeds the Tacoma Narrows Bridge",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "e5",
  "text": "until its deck tears apart.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "e6",
  "text": "Every structure has a beat it wants to move to.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "f1",
  "text": "Tremor asks the next question.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "f2",
  "text": "Find that beat.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "f3",
  "text": "Push exactly on it.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "f4",
  "text": "Each push adds a little.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "f5",
  "text": "The sway keeps growing.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "g1",
  "text": "Eight drivers, bolted to the foundation.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "g2",
  "text": "Tuned by laser to the building's sway.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "h1",
  "text": "Trial one. A ten-meter tower.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "h2",
  "text": "Down.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "h3",
  "text": "Thirty meters.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "h4",
  "text": "Down.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "h5",
  "text": "Sixty meters.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "h6",
  "text": "Down.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "i1",
  "text": "One side effect.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "i2",
  "text": "Glass cracks for three blocks around.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "j1",
  "text": "Tremor is cleared for demolition trials.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "j2",
  "text": "Tesla needed five pounds of air.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "j3",
  "text": "Tremor needs the right beat.",
  "voice": "bm_george",
  "speed": 0.95
 }
]