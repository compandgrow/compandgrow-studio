[
 {
  "id": "a1",
  "text": "Every ship ever built",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "a2",
  "text": "has the same weakness.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "a3",
  "text": "It can be seen.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "b1",
  "text": "Light leaves the sun,",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "b2",
  "text": "strikes the hull,",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "b3",
  "text": "and travels to your eye.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "b4",
  "text": "Break that path. The ship is gone.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "c1",
  "text": "We've hidden ships before.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "c2",
  "text": "By nineteen forty, hulls were wrapped in cable,",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "c3",
  "text": "to cancel their magnetic field.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "c4",
  "text": "Magnetic mines couldn't find them.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "d1",
  "text": "Hull Seven asks the next question.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "d2",
  "text": "Can coils hide a ship from light?",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "e1",
  "text": "Light already bends.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "e2",
  "text": "Over a hot road, layered air",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "e3",
  "text": "bends the sky down to your eye.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "e4",
  "text": "That's a mirage.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "f1",
  "text": "Now wrap that layer around a hull.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "f2",
  "text": "Light from the sea behind it",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "f3",
  "text": "curves around the hull,",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "f4",
  "text": "and reaches you. No ship.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "g1",
  "text": "Forty-six coil bands.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "g2",
  "text": "One every two meters, bow to stern.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "g3",
  "text": "Ninety-three meters of hull.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "g4",
  "text": "Power: four generators,",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "g5",
  "text": "one point two megawatts each.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "h1",
  "text": "Trial one. Five hundred meters.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "h2",
  "text": "Not seen.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "h3",
  "text": "Two kilometers.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "h4",
  "text": "Not seen.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "h5",
  "text": "Eight kilometers.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "h6",
  "text": "Not seen.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "i1",
  "text": "One side effect.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "i2",
  "text": "Within two hundred meters,",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "i3",
  "text": "compasses can't be trusted.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "j1",
  "text": "Hull Seven is cleared for sea trials.",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "j2",
  "text": "So. Can it be seen?",
  "voice": "bm_george",
  "speed": 0.94
 },
 {
  "id": "j3",
  "text": "Not anymore.",
  "voice": "bm_george",
  "speed": 0.94
 }
]