[
 {
  "id": "a1",
  "text": "A ball of fire, floating in the air.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "a2",
  "text": "It glows for a second.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "a3",
  "text": "Then it's gone.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "b1",
  "text": "Sixteen thirty-eight. A storm over Dartmoor, in England.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "b2",
  "text": "Witnesses describe a great ball of fire",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "b3",
  "text": "coming through a church window.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "c1",
  "text": "For centuries, it was only stories.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "c2",
  "text": "Then, in twenty twelve,",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "c3",
  "text": "scientists recording lightning in western China",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "c4",
  "text": "catch one on their spectrometer.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "c5",
  "text": "Nine hundred meters away. About one second.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "d1",
  "text": "Its light shows silicon, iron and calcium.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "d2",
  "text": "The stuff of soil.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "d3",
  "text": "Lightning hits the ground, and the ground burns in the air.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "e1",
  "text": "Labs can make small ones.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "e2",
  "text": "In two thousand seven, a team in Brazil",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "e3",
  "text": "touches an electric arc to a silicon wafer.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "e4",
  "text": "Glowing balls, up to four centimeters.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "e5",
  "text": "Up to eight seconds.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "f1",
  "text": "Ember asks the next question.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "f2",
  "text": "What if it never went out?",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "f3",
  "text": "Feed it silicon dust.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "f4",
  "text": "Hold it in a magnetic cage.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "f5",
  "text": "Draw power from its glow.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "h1",
  "text": "Trial one. Eight seconds.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "h2",
  "text": "Held.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "h3",
  "text": "Ninety seconds.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "h4",
  "text": "Held.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "h5",
  "text": "Six hours.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "h6",
  "text": "Held.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "i1",
  "text": "One side effect.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "i2",
  "text": "Every radio on the floor fills with static.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "j1",
  "text": "Ember is cleared for field trials.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "j2",
  "text": "The storm's ball lasted one second.",
  "voice": "bm_george",
  "speed": 0.95
 },
 {
  "id": "j3",
  "text": "Ember has to last all night.",
  "voice": "bm_george",
  "speed": 0.95
 }
]